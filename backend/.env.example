# ==========================================
# Bhumi Bazar Backend Environment Variables
# ==========================================
# Copy this file to .env (or .env.local) and fill in your actual values
# For security, never commit .env files to version control


# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=4000
NODE_ENV=development
BACKEND_URL="http://localhost:4000"


# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB Connection String
# Get this from MongoDB Atlas (https://cloud.mongodb.com) or use local MongoDB
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI="mongodb+srv://your_username:your_password@your_cluster.mongodb.net/buildestate?retryWrites=true&w=majority"


# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# Generate a strong random string for JWT (use: openssl rand -base64 32)
JWT_SECRET="your_super_secure_jwt_secret_here_make_it_long_and_random"


# ===========================================
# EMAIL CONFIGURATION (Required for user notifications)
# ===========================================
# Option 1: Brevo (SendinBlue) SMTP (Recommended - Free tier available)
# Sign up at https://www.brevo.com/
SMTP_USER="your_brevo_smtp_login"
SMTP_PASS="your_brevo_smtp_password"
EMAIL_USER="your_sender_email@domain.com"
BREVO_API_KEY="your_brevo_api_key"

# Option 2: Gmail SMTP (Alternative)
# Enable 2FA and generate App Password at https://myaccount.google.com/apppasswords
# SMTP_USER="your_email@gmail.com"
# SMTP_PASS="your_gmail_app_password"
# EMAIL="your_email@gmail.com"

# Admin Account Credentials (Change these!)
ADMIN_EMAIL="admin@buildestate.com"
ADMIN_PASSWORD="change_this_secure_password"


# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
# URL where your frontend is deployed
# Local: http://localhost:5173
# Vercel: https://your-project.vercel.app
WEBSITE_URL=""
# IMPORTANT: Set this to your production frontend URL (e.g. https://yourdomain.vercel.app)
# Email verification and password reset links are built from this value.
# Leaving it empty or pointing to localhost will break those emails in production.

# CORS allowlist (used by backend/server.js)
# Primary frontend URL
FRONTEND_URL="http://localhost:5173"
# Primary admin URL
ADMIN_URL="http://localhost:5174"
# Optional comma-separated local origins
LOCAL_URLS="http://localhost:5173,http://localhost:5174,http://localhost:4000"
# Optional extra origins (comma-separated)
EXTRA_ALLOWED_ORIGINS=""


# ===========================================
# IMAGE STORAGE (Optional but Recommended)
# ===========================================
# ImageKit provides free tier for image optimization and CDN
# Sign up at https://imagekit.io for free account (10GB free)
IMAGEKIT_PUBLIC_KEY="public_your_imagekit_public_key"
IMAGEKIT_PRIVATE_KEY="private_your_imagekit_private_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"


# ===========================================
# AI SERVICES (Optional - for AI Property Hub)
# ===========================================
# These are optional - only needed if you want AI property search features
# Users can still provide their own API keys via frontend

# Firecrawl for web scraping property data
# Get API key from https://www.firecrawl.dev/ (Free tier: 500 pages/month)
FIRECRAWL_API_KEY="fc-your_firecrawl_api_key_here"

# GitHub Models for AI (Free tier available)
# Generate Personal Access Token at https://github.com/settings/tokens
# No additional permissions needed for GitHub Models
GITHUB_MODELS_API_KEY="github_pat_your_github_personal_access_token"


# ===========================================
# OPTIONAL CONFIGURATIONS
# ===========================================
# Rate limiting (requests per hour)
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1000

# Session settings
SESSION_TIMEOUT_MINUTES=60

# File upload limits
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_PROPERTY=10

# ===========================================
# MOBILE APP API (/api/v1/app, docs at /api-docs)
# ===========================================
# Swagger UI at /api-docs — on by default outside production
# SWAGGER_ENABLED=true

# OTP delivery: console (dev only — code is logged and returned as devOtp) | msg91 | twilio
SMS_PROVIDER=console
DEFAULT_COUNTRY_CODE=+91
# Secret for hashing OTPs (falls back to JWT_SECRET)
OTP_SECRET=""
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
# At most OTP_MAX_SENDS_PER_WINDOW OTPs per number every OTP_SEND_WINDOW_MINUTES
OTP_MAX_SENDS_PER_WINDOW=3
OTP_SEND_WINDOW_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Fixed codes for app-store reviewers / QA — no SMS is sent. Comma-separated phone:code
OTP_TEST_PHONES=""
# Same code for EVERY number, no SMS sent (e.g. 123456). Dev/testing only —
# ignored when NODE_ENV=production.
OTP_DEFAULT_CODE=""

# MSG91 (India) — Flow API with a DLT-approved template containing an ##otp## variable
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_OTP_VAR=otp

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Sessions
APP_ACCESS_TOKEN_TTL_MINUTES=60
APP_REFRESH_TOKEN_TTL_DAYS=30

# Listings
# Default (unset/true): new and edited listings are 'pending' and hidden until an
# admin approves them in the admin Review Queue. false → publish immediately.
APP_LISTING_REQUIRE_APPROVAL=true
# auto = ImageKit when IMAGEKIT_* keys are set, else local disk (served from /uploads/app-media)
APP_MEDIA_STORAGE=auto
APP_NEW_LAUNCH_DAYS=30
# Max new buy/rent/lease enquiries one user can send per 24 hours
APP_ENQUIRIES_PER_DAY=30
APP_MAX_IMAGE_MB=10
APP_MAX_VIDEO_MB=100

# ===========================================
# BHOOMI BAZAR API v1 (/api/v1, docs at /api-docs/v1)
# Uses the OTP, session and listing settings above.
# ===========================================
# Photos per property (POST /api/v1/properties)
PROPERTY_MIN_IMAGES=1
PROPERTY_MAX_IMAGES=10
# Max size per photo for /api/v1/uploads/presign
UPLOAD_MAX_IMAGE_MB=5
# (BACKEND_URL above is used in upload URLs when S3 is not configured)

# AWS S3 for property photos (pre-signed uploads). When S3_BUCKET is empty,
# uploads go through this API to ImageKit / local disk instead.
S3_BUCKET=""
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# CloudFront domain serving the bucket, e.g. https://cdn.bhoomibazar.com (optional)
S3_PUBLIC_BASE_URL=""
S3_PRESIGN_EXPIRES_SECONDS=600

# Firebase Cloud Messaging (push notifications). Either the service-account
# JSON (raw or base64) or the three fields. Empty = in-app notifications only.
FIREBASE_SERVICE_ACCOUNT=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
